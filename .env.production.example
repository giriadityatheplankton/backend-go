# ==============================================================================
# Production template. Do NOT commit real values and do NOT bake this file into
# the image: .env files are ignored when APP_ENV=production. Provide these through
# the orchestrator (ConfigMap for settings, Secret manager / External Secrets for
# anything marked SECRET).
# ==============================================================================
APP_ENV=production
LOG_LEVEL=info

SERVER_ADDRESS=:8080
GRPC_ADDRESS=:50051
ADMIN_ADDRESS=:9090            # cluster-internal only
PPROF_ENABLED=false
GRPC_REFLECTION=false

AUTH_MODE=jwt
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=backend-go
# SECRET: JWT_HMAC_SECRET (>= 32 chars)

# SECRET: DB_PRIMARY_DSN, DB_REPLICA_DSNS (sslmode=verify-full)
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# State Redis (idempotency, locks, streams): noeviction + AOF, TLS + ACL user.
REDIS_MODE=cluster             # the address below is a cluster endpoint, so the mode MUST be cluster
REDIS_ADDRESSES=redis-0.redis.internal:6379,redis-1.redis.internal:6379,redis-2.redis.internal:6379
REDIS_USERNAME=backend-go
REDIS_TLS=true
REDIS_REQUIRED=true
# SECRET: REDIS_PASSWORD
# Cache Redis (allkeys-lru is fine here):
REDIS_CACHE_MODE=single
REDIS_CACHE_ADDRESSES=redis-cache.internal:6379
REDIS_CACHE_TLS=true
# SECRET: REDIS_CACHE_PASSWORD
CACHE_TTL=15m

IDEMPOTENCY_FAILURE_MODE=closed
EMBED_WORKER=false             # run cmd/worker as its own Deployment
OUTBOX_PARTITIONS=16
OUTBOX_BATCH_SIZE=200

DRAIN_DELAY=2s
SHUTDOWN_TIMEOUT=15s
PRESTOP_DELAY=3s
TERMINATION_GRACE=30s
