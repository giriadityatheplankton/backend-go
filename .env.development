# ==============================================================================
# Development Environment Configuration (.env.development)
# Tailored for local developer productivity, debugging, and breakpoint testing.
# ==============================================================================

# Application Environment & Log Level (Debug mode for full diagnostic traces)
APP_ENV=development
LOG_LEVEL=debug

# Network Bindings
SERVER_ADDRESS=127.0.0.1:8080
GRPC_ADDRESS=127.0.0.1:50051
PPROF_ADDRESS=127.0.0.1:6060

# Extended Timeouts (Prevents connection drops during IDE breakpoints & debugging)
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=5s

# Database Configuration (Local PostgreSQL)
DB_PRIMARY_DSN=postgres://postgres:postgres@127.0.0.1:5432/appdb_dev?sslmode=disable
DB_REPLICA_DSN=postgres://postgres:postgres@127.0.0.1:5432/appdb_dev?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=10m

# Redis & Cache (Short TTL for fast local iteration)
REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=1m

# Message Broker (Local NATS server)
NATS_ADDRESS=nats://127.0.0.1:4222

# Transactional Outbox Worker (Lightweight concurrency for local machine)
OUTBOX_PARTITIONS=2
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_MAX_RETRIES=3

# Idempotency & Rate Limiting (Relaxed limits during development)
IDEMPOTENCY_TTL=10m
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=1m
