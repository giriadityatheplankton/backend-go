# Local development defaults (loaded when APP_ENV=development). See .env.example for every key.
APP_ENV=development
LOG_LEVEL=debug

SERVER_ADDRESS=127.0.0.1:8080
ADMIN_ADDRESS=127.0.0.1:9090
GRPC_ADDRESS=127.0.0.1:50051
PPROF_ENABLED=true
GRPC_REFLECTION=true

# Generous timeouts so breakpoints do not trip deadlines.
READ_TIMEOUT=60s
WRITE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=50s
GRPC_REQUEST_TIMEOUT=50s
IDEMPOTENCY_INFLIGHT_TTL=60s
SHUTDOWN_TIMEOUT=5s

AUTH_MODE=static
AUTH_STATIC_TOKENS=dev-token-0123456789abcdefghij;dev;tenant-dev;orders:read,orders:write,users:read

DB_PRIMARY_DSN=postgres://postgres:postgres@127.0.0.1:5432/appdb?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5

REDIS_MODE=single
REDIS_ADDRESSES=127.0.0.1:6379
CACHE_TTL=1m

OUTBOX_PARTITIONS=2
OUTBOX_BATCH_SIZE=20
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_MAX_RETRIES=3

IDEMPOTENCY_TTL=10m
RATE_LIMIT_REQUESTS=1000
EMBED_WORKER=true
