# ==============================================================================
# Production Environment Configuration (.env.production)
# Hardened settings for high-throughput, security, and strict timeouts.
# ==============================================================================

# Application Environment & Log Level (Production mode, filtered structured logs)
APP_ENV=production
LOG_LEVEL=info

# Network Bindings (Bind to all interfaces inside container)
SERVER_ADDRESS=:8080
GRPC_ADDRESS=:50051
PPROF_ADDRESS=127.0.0.1:6060

# Strict Timeouts (Protection against Slowloris and connection leaks)
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Database Configuration (Primary & Read-Replica with High Concurrency Pool)
DB_PRIMARY_DSN=postgres://app_user:CHANGE_ME_SECRET@primary-db.internal:5432/appdb?sslmode=require
DB_REPLICA_DSN=postgres://app_user:CHANGE_ME_SECRET@replica-db.internal:5433/appdb?sslmode=require
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=15m

# Redis Cluster & Cache Configuration
REDIS_ADDRESS=redis-cluster.internal:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_SECRET
REDIS_DB=0
CACHE_TTL=15m

# Message Broker (Production NATS / JetStream cluster)
NATS_ADDRESS=nats://nats-cluster.internal:4222

# Transactional Outbox Worker (High-throughput partitioned batching)
OUTBOX_PARTITIONS=16
OUTBOX_BATCH_SIZE=200
OUTBOX_POLL_INTERVAL=100ms
OUTBOX_MAX_RETRIES=5

# Idempotency & Distributed Rate Limiter (Strict SLA per client/tenant)
IDEMPOTENCY_TTL=24h
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
