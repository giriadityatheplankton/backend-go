# ==============================================================================
# Configuration reference. Copy to .env (development only; .env files are NOT
# read when APP_ENV=production). Every value is validated at startup: a malformed
# value stops the process instead of silently falling back to a default.
# Durations need a unit: 500ms, 10s, 5m, 24h.
# ==============================================================================

# --- Identity ------------------------------------------------------------------
APP_ENV=development            # development | test | staging | production
SERVICE_NAME=backend-go        # prefix for Redis keys, consumer group, log field
LOG_LEVEL=debug

# --- HTTP (public) ----------------------------------------------------------------
SERVER_ADDRESS=127.0.0.1:8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s              # must be >= HTTP_REQUEST_TIMEOUT
IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
MAX_BODY_BYTES=1048576
TRUSTED_PROXIES=               # CIDRs allowed to set X-Forwarded-For; empty trusts none
CORS_ALLOWED_ORIGINS=          # comma separated; empty denies all cross-origin calls
CORS_ALLOW_CREDENTIALS=false

# --- Admin (probes, /metrics, pprof): keep this port internal ---------------------
ADMIN_ADDRESS=127.0.0.1:9090
PPROF_ENABLED=true             # default false in production

# --- gRPC -------------------------------------------------------------------------
GRPC_ADDRESS=127.0.0.1:50051
GRPC_REQUEST_TIMEOUT=10s
GRPC_REFLECTION=true           # must be false in production
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

# --- Graceful shutdown ------------------------------------------------------------
# DRAIN_DELAY + SHUTDOWN_TIMEOUT + PRESTOP_DELAY must fit TERMINATION_GRACE
# (= Kubernetes terminationGracePeriodSeconds).
DRAIN_DELAY=2s
SHUTDOWN_TIMEOUT=15s
PRESTOP_DELAY=3s
TERMINATION_GRACE=30s

# --- Authentication ---------------------------------------------------------------
# none (dev only) | static (service tokens) | jwt
AUTH_MODE=static
# static: token;subject;tenant;scope1,scope2|token2;...   (tokens >= 24 chars)
AUTH_STATIC_TOKENS=dev-token-0123456789abcdefghij;dev;tenant-dev;orders:read,orders:write,users:read
JWT_HMAC_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# --- PostgreSQL -------------------------------------------------------------------
DB_PRIMARY_DSN=postgres://postgres:postgres@127.0.0.1:5432/appdb?sslmode=disable
DB_REPLICA_DSNS=               # comma separated read replicas (optional)
DB_MAX_OPEN_CONNS=25           # replicas x this must stay below max_connections
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=15s
DB_REPLICA_PROBE_INTERVAL=5s

# --- Redis: "state" (idempotency, locks, streams) ---------------------------------
# Use noeviction + appendonly yes. single | sentinel | cluster
REDIS_MODE=single
REDIS_ADDRESSES=127.0.0.1:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0                     # must be 0 for cluster
REDIS_MASTER_NAME=             # sentinel only
REDIS_TLS=false
REDIS_REQUIRED=true            # false lets dev start without Redis (degraded); true required in production
# Optional: a separate Redis for cache (may use allkeys-lru). Unset = reuse state Redis.
# REDIS_CACHE_MODE=single
# REDIS_CACHE_ADDRESSES=127.0.0.1:6380
CACHE_TTL=5m

# --- Messaging (Redis Streams) ----------------------------------------------------
STREAM_PREFIX=
STREAM_MAXLEN=100000
CONSUMER_GROUP=                # defaults to SERVICE_NAME
CONSUMER_WORKERS=8             # use 1 where strict per-stream ordering is required
CONSUMER_BATCH_SIZE=32
CONSUMER_MAX_DELIVERIES=5
CONSUMER_CLAIM_IDLE=1m         # crash-visibility timeout and minimum retry delay
INBOX_RETENTION=336h

# --- Transactional outbox ---------------------------------------------------------
OUTBOX_PARTITIONS=8
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=200ms
OUTBOX_MAX_RETRIES=5
OUTBOX_LEASE=30s
OUTBOX_PRESERVE_ORDER=true     # per-aggregate ordering; false = more throughput
OUTBOX_RETENTION=168h

# --- Idempotency, rate limit, resilience ------------------------------------------
IDEMPOTENCY_TTL=24h
IDEMPOTENCY_INFLIGHT_TTL=30s   # must be >= request timeout + 5s
IDEMPOTENCY_FAILURE_MODE=closed # closed (503 when Redis is down) | open (skip edge dedupe, rely on DB)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_FAIL_OPEN=true
BREAKER_CONSECUTIVE_FAILURES=5
BREAKER_OPEN_TIMEOUT=10s

# --- Background jobs --------------------------------------------------------------
EMBED_WORKER=true              # cmd/api also runs the worker; use false + cmd/worker in production
RECONCILE_INTERVAL=5m
RECONCILE_THRESHOLD=15m
